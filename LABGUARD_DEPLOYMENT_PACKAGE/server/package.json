{
  "name": "@labguard/backend",
  "version": "3.5.1",
  "description": "LABGUARD Institutional Central API & Synchronization Server",
  "main": "dist/backend/src/server.js",
  "scripts": {
    "build": "tsc",
    "bundle": "npx esbuild src/server.ts --bundle --platform=node --target=node20 --external:pg-native --outfile=../dist/server/server.bundle.cjs",
    "start": "node dist/backend/src/server.js",
    "dev": "ts-node src/server.ts",
    "test": "node --test dist/backend/src/tests/**/*.test.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5",
    "uuid": "^9.0.1",
    "ws": "^8.16.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.11.24",
    "@types/pg": "^8.11.4",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}